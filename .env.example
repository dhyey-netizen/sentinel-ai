# Copy to .env and export (e.g. `set -a; source .env; set +a`). No API keys are needed.
SENTINEL_OLLAMA_URL=http://localhost:11434
SENTINEL_OLLAMA_MODEL=qwen3:4b
SENTINEL_OLLAMA_NUM_CTX=8192
SENTINEL_OLLAMA_TEMPERATURE=0
SENTINEL_OLLAMA_TIMEOUT_S=300
SENTINEL_DB_PATH=data/sentinel.db
SENTINEL_MAX_LOG_BYTES=2000000
SENTINEL_MAX_QUESTION_CHARS=1000
SENTINEL_MAX_LINE_CHARS=2000
SENTINEL_MAX_ITERATIONS=4
SENTINEL_MAX_EVIDENCE=60
